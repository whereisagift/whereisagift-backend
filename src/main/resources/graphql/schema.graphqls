type User {
    id: ID!
    telegramId: String!
    username: String!
    firstName: String!
    lastName: String!
    photoUrl: String!
    wishlists: [Wishlist]
    wishes: [Wish]
}

type Wishlist {
    id: ID!
    name: String!
    creator: User!
    wishes: [Wish]
}

type Wish {
    id: ID!
    name: String!
    url: String!
    pictureUrl: String
    booking: Booking
    creator: User!
    wishlists: [Wishlist]
    orderDate: String
    price: String
}

type Booking {
    reservist: Reservist!
    date: String!
}

type Reservist {
    id: String!
    nickname: String!
}

input AuthPayload {
    telegramId: String!
    firstName: String!
    lastName: String!
    username: String!
    photoUrl: String!
    authDate: String!
    hash: String!
}

type Query {
    users: [User!]!
    user(id: ID!): User
    wishlists: [Wishlist]
    wishes: [Wish]
}

type Mutation {
    createUser(telegramId: String!, firstName: String!, lastName: String!, username: String!, photoUrl: String!): User
    createWishlist(name: String!): Wishlist
    createWish(name: String!): Wish
    login(
        authPayload: AuthPayload!
    ): User
    bookingWish(telegramId: Int!, wishId: Int!): Booking!
}

