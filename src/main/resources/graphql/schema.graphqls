type User {
    id: ID!
    telegramId: String!
    username: String!
    firstName: String!
    lastName: String!
    photoUrl: String!
    wishlists: [Wishlist]
    wishes: [Wish]
}

type Wishlist {
    id: ID!
    name: String!
    creator: User!
    wishes: [Wish]
}

type Wish {
    id: ID!
    name: String!
    creator: User!
    wishlists: [Wishlist]
}

type AuthPayload {
    user: User!
}

type AuthData {
    telegramId: String!
    firstName: String!
    lastName: String!
    username: String!
    photoUrl: String!
    authDate: String!
    hash: String!
}

type Query {
    users: [User!]!
    user(id: ID!): User
    wishlists: [Wishlist]
    wishes: [Wish]
}

type Mutation {
    createUser(telegramId: String!, firstName: String!, lastName: String!, username: String!, photoUrl: String!): User
    createWishlist(name: String!): Wishlist
    createWish(name: String!): Wish
    login(
        authData: AuthData!
    ): AuthPayload
}

