type User {
    id: ID!
    telegramId: String!
    username: String!
    firstName: String!
    lastName: String!
    photoUrl: String!
    wishlists: [Wishlist]
    wishes: [Wish]
}

type Wishlist {
    id: ID!
    name: String!
    creator: User!
    wishes: [Wish]
}

type Wish {
    id: ID!
    name: String!
    creator: User!
    wishlists: [Wishlist]
}

input AuthPayload {
    telegramId: String!
    firstName: String!
    lastName: String!
    username: String!
    photoUrl: String!
    authDate: String!
    hash: String!
}

type Query {
    users: [User!]!
    user(id: ID!): User
    wishlists: [Wishlist]
    wishes: [Wish]
}

type Mutation {
    createWishlist(name: String!): Wishlist
    createWish(name: String!): Wish
    login(
        authPayload: AuthPayload!
    ): User
}

